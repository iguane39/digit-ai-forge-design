# Modèle à copier en .env — ne jamais renseigner de secret ici.
#   cp .env.example .env

# TF-0588 : un secret attendu se PREPARE, il ne se decrit pas en prose — trois aller-retours et
# deux jetons crees pour rien l'ont mesure le 25/08. A creer sur Google AI Studio
# (https://aistudio.google.com/apikey), portee : generation d'images. API PAYANTE : premier appel
# sur GO humain explicite (R-29). Verifier la cle sans depenser : un appel de liste de modeles.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
IMAGES_OUT_DIR=./generated/images
IMAGES_MAX_PAR_RUN=12
IMAGES_MAX_KO=400

FORGE_DESIGN_ROOT=
